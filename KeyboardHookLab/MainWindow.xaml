<Window x:Class="KeyboardHookLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Hook Laboratory"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#F1F2F4"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        Activated="OnWindowActivated"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#292D36"/>
            <Setter Property="Foreground" Value="#F1F2F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#191C23"/>
            <Setter Property="Foreground" Value="#D5D8DF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,28">

            <TextBlock Text="KEYBOARD LAB"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#858D9C"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Keyboard Events"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Windows keyboard event monitoring"
                       FontSize="14"
                       Foreground="#858D9C"
                       Margin="0,7,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="#191C23"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="APPLICATION STATUS"
                               FontSize="11"
                               Foreground="#858D9C"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ApplicationStatus}"
                               FontSize="14"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="Clear journal"
                        Command="{Binding ClearKeyboardEventsCommand}"
                        VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <Border Grid.Row="2"
                Background="#191C23"
                CornerRadius="10"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,15">

                    <TextBlock Text="EVENT JOURNAL"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#858D9C"
                               DockPanel.Dock="Left"/>

                    <TextBlock Text="{Binding KeyboardEvents.Count}"
                               FontSize="12"
                               Foreground="#858D9C"
                               DockPanel.Dock="Right"/>

                </DockPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding KeyboardEvents}"
                         DisplayMemberPath="DisplayText"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            </Grid>

        </Border>

        <TextBlock Grid.Row="3"
                   Text="Keyboard Hook Laboratory · .NET 9 · WPF"
                   FontSize="11"
                   Foreground="#626B7A"
                   HorizontalAlignment="Right"
                   Margin="0,15,0,0"/>

    </Grid>

</Window>
